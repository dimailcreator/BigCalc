{
  "name": "bigcalc-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Verified mathematical core for BigCalc.",
  "main": "./dist/core/api.js",
  "types": "./dist/core/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/api.d.ts",
      "import": "./dist/core/api.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:app": "vite --config vite.config.js",
    "build:app": "vite build --config vite.config.js",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.app-test.json --noEmit",
    "test:app": "vitest run --config vitest.config.js",
    "test:app:e2e": "playwright test --config playwright.config.js",
    "check:app": "npm run typecheck:app && npm run test:app && npm run test:app:e2e && npm run build:app",
    "android:sync": "npm run build:app && cap sync android",
    "android:build:debug": "npm run android:sync && node scripts/build-android-debug.mjs",
    "test:android:smoke": "node scripts/android-webview-smoke.mjs",
    "test:android:lifecycle": "node scripts/android-lifecycle-smoke.mjs",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node dist-test/tests/run-tests.js && npm run test:benchmarks",
    "test:benchmarks": "npm run build && node --test benchmarks/algorithm-harness.test.mjs",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "benchmark:scaling": "npm run build && node --expose-gc benchmarks/core-scaling.mjs --full",
    "benchmark:scaling:quick": "npm run build && node --expose-gc benchmarks/core-scaling.mjs",
    "benchmark:algorithms": "npm run build && node --expose-gc benchmarks/algorithm-comparison.mjs",
    "audit:public-api": "npm run build && node scripts/audit-public-api.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && node scripts/audit-public-api.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.0",
    "chrome-remote-interface": "0.33.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9"
  }
}
