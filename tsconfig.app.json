{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@bigcalc/core": ["./src/core/api.ts"]
    }
  },
  "include": ["src/app/**/*.ts", "capacitor.config.ts"],
  "exclude": ["dist-app", "node_modules"]
}
